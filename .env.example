# Copy to .env and fill in, then restart the server.

# Port the server listens on (default: 3000)
PORT=3000

# Passcode required to open /admin.html (leave empty to disable the gate — not recommended)
ADMIN_PASSCODE=change-me

# Confirmation email sender address
MAIL_FROM=RENiKA <hello@renika.health>

# SMTP settings for real confirmation emails.
# If SMTP_HOST is NOT set, the server uses a free Ethereal test account:
# emails are not delivered to real inboxes, but a preview URL is printed
# to the server console for every confirmation sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
