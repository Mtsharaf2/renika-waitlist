{
  "name": "renika-waitlist",
  "version": "1.0.0",
  "description": "RENiKA — waitlist landing page with admin dashboard and confirmation emails",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cf:dev": "wrangler dev --port 8788",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "wrangler": "^4.143.1"
  }
}
